#!/bin/bash
# Read-only installation and runtime diagnostics.

set -u
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/common.sh"

SETTINGS="$CM_SETTINGS_FILE_DEFAULT"
STATE_DIR="$CM_STATE_DIR_DEFAULT"
LAUNCH_AGENTS_DIR="$CM_LAUNCH_AGENTS_DIR_DEFAULT"
STRICT=0
JSON_OUTPUT=0

usage() {
  cat <<'USAGE'
Usage: doctor [options]

Run read-only checks. Missing build output is a warning because the adapter may
be built after setup. Use --strict to treat a missing adapter as an error.

Options:
  --settings PATH          settings JSON
  --state-dir PATH         monitor state directory
  --launch-agents-dir PATH LaunchAgents directory
  --strict                 fail when the adapter is missing
  --json                   print machine-readable JSON
  -h, --help               show this help
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --settings) [ "$#" -ge 2 ] || cm_usage_error "--settings needs a path"; SETTINGS="$2"; shift 2 ;;
    --state-dir) [ "$#" -ge 2 ] || cm_usage_error "--state-dir needs a path"; STATE_DIR="$2"; shift 2 ;;
    --launch-agents-dir) [ "$#" -ge 2 ] || cm_usage_error "--launch-agents-dir needs a path"; LAUNCH_AGENTS_DIR="$2"; shift 2 ;;
    --strict) STRICT=1; shift ;;
    --json) JSON_OUTPUT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) cm_usage_error "unknown option: $1" ;;
  esac
done

cm_require_command "$CM_PYTHON_DEFAULT"
SETTINGS="$(cm_abs_path "$SETTINGS")"
STATE_DIR="$(cm_abs_path "$STATE_DIR")"
LAUNCH_AGENTS_DIR="$(cm_abs_path "$LAUNCH_AGENTS_DIR")"
INSTALL_FILE="$STATE_DIR/install.json"
PLIST="$LAUNCH_AGENTS_DIR/$CM_LAUNCHD_LABEL.plist"

HOOK_JSON="$(cm_python "$CM_SCRIPT_DIR/lib/settings.py" inspect --settings "$SETTINGS" --marker "$CM_HOOK_MARKER" 2>/dev/null || printf '{"count":0,"events":{}}')"
DOCTOR_JSON="$(cm_python - "$SETTINGS" "$STATE_DIR" "$INSTALL_FILE" "$PLIST" "$CM_ADAPTER_DEFAULT" "$HOOK_JSON" "$STRICT" <<'PY'
from __future__ import annotations

import json
import os
import pathlib
import sys
import xml.etree.ElementTree as ET

settings_file, state_dir, install_file, plist, default_adapter, hook_json, strict = sys.argv[1:]
strict = strict == "1"
checks = []
def add(name, ok, detail, severity="error"):
    checks.append({"name": name, "ok": bool(ok), "detail": detail, "severity": severity})

settings = pathlib.Path(settings_file)
state = pathlib.Path(state_dir)
install_path = pathlib.Path(install_file)
plist_path = pathlib.Path(plist)
try:
    json.loads(settings.read_text(encoding="utf-8"))
    add("settings-json", True, str(settings))
except FileNotFoundError:
    add("settings-json", False, f"missing: {settings}", "warning")
except (OSError, json.JSONDecodeError) as exc:
    add("settings-json", False, str(exc))

try:
    hooks = json.loads(hook_json)
except json.JSONDecodeError:
    hooks = {"count": 0, "events": {}}
expected = {}
install = {}
try:
    install = json.loads(install_path.read_text(encoding="utf-8"))
    if install.get("hooks_enabled", True):
        expected = {name: 1 for name in install.get("events", [])}
except (FileNotFoundError, OSError, json.JSONDecodeError):
    pass
actual = hooks.get("events", {}) if isinstance(hooks, dict) else {}
missing = sorted(set(expected) - set(actual))
extra = sorted(set(actual) - set(expected)) if expected else []
add("owned-hooks", not missing and (not expected or not extra),
    "hooks disabled by install" if install and not install.get("hooks_enabled", True)
    else "{} entries".format(hooks.get("count", 0)) if not (missing or extra)
    else f"missing={missing}, extra={extra}")

add("state-directory", state.is_dir(), str(state))
add("state-writable", os.access(state, os.W_OK), str(state), "warning")
adapter = pathlib.Path(install.get("adapter") or default_adapter)
add("adapter", adapter.is_file(), str(adapter), "error" if strict else "warning")

if plist_path.is_file():
    try:
        text = plist_path.read_text(encoding="utf-8")
        ET.fromstring(text)
        add("launchd-plist", "__CM_" not in text, str(plist_path))
    except (OSError, ET.ParseError) as exc:
        add("launchd-plist", False, str(exc))
else:
    add("launchd-plist", False, f"missing: {plist_path}", "warning")

if sys.platform == "darwin":
    add("platform", True, "macOS")
else:
    add("platform", False, f"{sys.platform} (helpers are intended for macOS)", "warning")

errors = [item for item in checks if not item["ok"] and item["severity"] == "error"]
result = {"ok": not errors, "checks": checks, "errors": len(errors), "warnings": sum(not item["ok"] and item["severity"] == "warning" for item in checks)}
print(json.dumps(result, sort_keys=True))
PY
)" || cm_die "could not run diagnostics"

if [ "$JSON_OUTPUT" -eq 1 ]; then
  printf '%s\n' "$DOCTOR_JSON"
else
  cm_python - "$DOCTOR_JSON" <<'PY'
import json
import sys
value = json.loads(sys.argv[1])
print("Claude phone monitor doctor")
for check in value["checks"]:
    label = "OK" if check["ok"] else ("WARN" if check["severity"] == "warning" else "FAIL")
    print(f"  [{label}] {check['name']}: {check['detail']}")
print(f"Summary: {value['errors']} errors, {value['warnings']} warnings")
PY
fi

# Keep warnings non-fatal; failures indicate a broken install.
if printf '%s' "$DOCTOR_JSON" | cm_python -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin)["ok"] else 1)'; then
  exit 0
else
  exit 1
fi
