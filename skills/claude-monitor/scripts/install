#!/bin/bash
# Install the Claude phone monitor's user-level hooks and launch agent.
# This is intentionally separate from hook-event delivery: Claude invokes the
# generated hook commands, never this setup command.

set -u
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib/common.sh"

SETTINGS="$CM_SETTINGS_FILE_DEFAULT"
STATE_DIR="$CM_STATE_DIR_DEFAULT"
LAUNCH_AGENTS_DIR="$CM_LAUNCH_AGENTS_DIR_DEFAULT"
ADAPTER="$CM_ADAPTER_DEFAULT"
NODE="$CM_NODE_DEFAULT"
ENDPOINT="$CM_ENDPOINT_DEFAULT"
EVENTS="$CM_DEFAULT_EVENTS"
INSTALL_ROOT="$CM_REPO_ROOT"
NO_LOAD=0
NO_HOOKS=0
NO_LAUNCHD=0
HOOK_COMMAND=""

usage() {
  cat <<'USAGE'
Usage: install [options]

Install the monitor's own Claude Code hooks, state files, and launchd plist.
The settings merge is marker-based and preserves unrelated hooks.

Options:
  --settings PATH          Settings JSON (default: ~/.claude/settings.json)
  --state-dir PATH         Monitor state directory (default: ~/.claude-phone-monitor)
  --launch-agents-dir PATH LaunchAgents directory (default: ~/Library/LaunchAgents)
  --adapter PATH            hook-adapter.js path
  --node COMMAND            node executable (default: node)
  --hook-command COMMAND    complete adapter command; overrides --node/--adapter
  --endpoint URL            development event endpoint
  --events CSV              hook events (default: the supported monitor lifecycle set)
  --install-root PATH       repository/skill root used in generated plist
  --no-hooks                only generate state and launchd files
  --no-launchd              do not generate a LaunchAgent plist
  --no-load                 generate the plist but do not load it with launchctl
  -h, --help                show this help
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --settings) [ "$#" -ge 2 ] || cm_usage_error "--settings needs a path"; SETTINGS="$2"; shift 2 ;;
    --state-dir) [ "$#" -ge 2 ] || cm_usage_error "--state-dir needs a path"; STATE_DIR="$2"; shift 2 ;;
    --launch-agents-dir) [ "$#" -ge 2 ] || cm_usage_error "--launch-agents-dir needs a path"; LAUNCH_AGENTS_DIR="$2"; shift 2 ;;
    --adapter) [ "$#" -ge 2 ] || cm_usage_error "--adapter needs a path"; ADAPTER="$2"; shift 2 ;;
    --node) [ "$#" -ge 2 ] || cm_usage_error "--node needs a command"; NODE="$2"; shift 2 ;;
    --hook-command) [ "$#" -ge 2 ] || cm_usage_error "--hook-command needs a command"; HOOK_COMMAND="$2"; shift 2 ;;
    --endpoint) [ "$#" -ge 2 ] || cm_usage_error "--endpoint needs a URL"; ENDPOINT="$2"; shift 2 ;;
    --events) [ "$#" -ge 2 ] || cm_usage_error "--events needs CSV"; EVENTS="$2"; shift 2 ;;
    --install-root) [ "$#" -ge 2 ] || cm_usage_error "--install-root needs a path"; INSTALL_ROOT="$2"; shift 2 ;;
    --no-hooks) NO_HOOKS=1; shift ;;
    --no-launchd) NO_LAUNCHD=1; shift ;;
    --no-load) NO_LOAD=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) cm_usage_error "unknown option: $1" ;;
  esac
done

cm_require_command "$CM_PYTHON_DEFAULT"
SETTINGS="$(cm_abs_path "$SETTINGS")"
STATE_DIR="$(cm_abs_path "$STATE_DIR")"
LAUNCH_AGENTS_DIR="$(cm_abs_path "$LAUNCH_AGENTS_DIR")"
INSTALL_ROOT="$(cm_abs_path "$INSTALL_ROOT")"
ADAPTER="$(cm_abs_path "$ADAPTER")"
cm_mkdir_state "$STATE_DIR"

if [ -z "$HOOK_COMMAND" ]; then
  # The adapter receives JSON on stdin from Claude Code.  settings.py quotes
  # each command token before writing it to settings.json.
  HOOK_COMMAND="$(cm_python - "$NODE" "$ADAPTER" <<'PY'
import shlex
import sys
print(shlex.join(sys.argv[1:]))
PY
)"
fi

# Keep a user-owned, inspectable configuration file. Values are quoted as a
# shell fragment because monitor-daemon sources only this generated file.
cm_python - "$STATE_DIR/monitor.env" "$ENDPOINT" "$ADAPTER" "$NODE" "$HOOK_COMMAND" <<'PY'
import os
import pathlib
import shlex
import sys

path, endpoint, adapter, node, hook_command = sys.argv[1:]
existing = {}
try:
    for line in pathlib.Path(path).read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            key, value = line.split("=", 1)
            if key.startswith(("RELAY_", "COLLECTOR_")):
                existing[key] = value
except OSError:
    pass
values = {
    "CLAUDE_PHONE_MONITOR_ENDPOINT": shlex.quote(endpoint),
    "CLAUDE_PHONE_MONITOR_ADAPTER": shlex.quote(adapter),
    "CLAUDE_PHONE_MONITOR_NODE": shlex.quote(node),
    "CLAUDE_PHONE_MONITOR_HOOK_COMMAND": shlex.quote(hook_command),
}
values.update(existing)
lines = ["# Generated by claude-phone-monitor; edit with the helper scripts."]
lines.extend(f"{key}={value}" for key, value in values.items())
tmp = pathlib.Path(path + ".tmp")
tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY

if [ ! -f "$ADAPTER" ]; then
  cm_warn "adapter is not present yet: $ADAPTER (hooks will fail open until it is built)"
fi

HOOK_INFO='{"count":0,"events":{}}'
if [ "$NO_HOOKS" -eq 0 ]; then
  HOOK_INFO="$(cm_python "$CM_SCRIPT_DIR/lib/settings.py" add \
    --settings "$SETTINGS" \
    --hook-command "$HOOK_COMMAND" \
    --events "$EVENTS" \
    --marker "$CM_HOOK_MARKER")" || cm_die "could not update $SETTINGS"
fi

LAUNCH_AGENT="$LAUNCH_AGENTS_DIR/$CM_LAUNCHD_LABEL.plist"
STATE_PLIST="$STATE_DIR/$CM_LAUNCHD_LABEL.plist"
if [ "$NO_LAUNCHD" -eq 0 ]; then
  [ -f "$CM_TEMPLATE" ] || cm_die "launchd template is missing: $CM_TEMPLATE"
  cp "$CM_TEMPLATE" "$STATE_DIR/launchd.template.plist" || cm_die "cannot save launchd template"
  chmod 600 "$STATE_DIR/launchd.template.plist" 2>/dev/null || true
  cm_render_plist "$STATE_PLIST" "$INSTALL_ROOT" "$STATE_DIR" "$ADAPTER" "$NODE" \
    || cm_die "cannot render launchd plist"
  cm_render_plist "$LAUNCH_AGENT" "$INSTALL_ROOT" "$STATE_DIR" "$ADAPTER" "$NODE" \
    || cm_die "cannot render launchd plist"
  if [ "$NO_LOAD" -eq 0 ]; then
    cm_launchctl_bootstrap "$LAUNCH_AGENT"
  fi
fi

cm_python - "$STATE_DIR/install.json" "$SETTINGS" "$STATE_DIR" "$LAUNCH_AGENT" "$ADAPTER" "$NODE" "$ENDPOINT" "$EVENTS" "$HOOK_COMMAND" "$NO_HOOKS" <<'PY'
import datetime
import json
import os
import pathlib
import sys

path, settings, state_dir, plist, adapter, node, endpoint, events, hook_command, no_hooks = sys.argv[1:]
try:
    previous = json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    previous = {}
installed_at = previous.get("installed_at") or datetime.datetime.now(datetime.timezone.utc).isoformat()
data = {
    "version": "0.1.0",
    "installed_at": installed_at,
    "settings": settings,
    "state_dir": state_dir,
    "launch_agent": plist,
    "adapter": adapter,
    "node": node,
    "endpoint": endpoint,
    "hooks_enabled": no_hooks != "1",
    "events": [item.strip() for item in events.split(",") if item.strip()],
    "hook_command": hook_command,
}
tmp = pathlib.Path(path + ".tmp")
tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY

printf 'Installed Claude phone monitor.\n'
printf '  state: %s\n' "$STATE_DIR"
printf '  settings: %s\n' "$SETTINGS"
if [ "$NO_HOOKS" -eq 0 ]; then
  printf '  hooks: %s\n' "$HOOK_INFO"
else
  printf '  hooks: skipped (--no-hooks)\n'
fi
if [ "$NO_LAUNCHD" -eq 0 ]; then
  printf '  launchd: %s\n' "$LAUNCH_AGENT"
else
  printf '  launchd: skipped (--no-launchd)\n'
fi
printf 'Hook delivery is fail-open; Claude Code continues if the adapter is unavailable.\n'
