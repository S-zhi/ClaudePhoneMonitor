# Real LAN example. Generated monitor.env files are mode 0600.
RELAY_PUBLIC_URL=http://192.168.1.3:8787
RELAY_BOOTSTRAP_SECRET=replace-with-a-long-url-safe-secret
COLLECTOR_RELAY_URL=ws://192.168.1.3:8787/ws/collector
COLLECTOR_RELAY_TOKEN=issued-by-relay-pairing
COLLECTOR_INSTALLATION_ID=issued-or-generated-installation-id
COLLECTOR_DATA_DIR=$HOME/.claude-phone-monitor
COLLECTOR_SOCKET_PATH=$HOME/.claude-phone-monitor/collector.sock
RELAY_DB_PATH=$HOME/.claude-phone-monitor/relay.sqlite

# Development-only local fallback:
# RELAY_AUTH_MODE=development
# CLAUDE_PHONE_MONITOR_ENDPOINT=http://127.0.0.1:8787/events
# CLAUDE_PHONE_MONITOR_ADAPTER=/absolute/path/to/services/collector/dist/cli.js
# CLAUDE_PHONE_MONITOR_NODE=node
