{
  "name": "@claude-phone-monitor/collector",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving macOS collector for Claude phone monitor",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "bin": {
    "claude-phone-monitor-collector": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
