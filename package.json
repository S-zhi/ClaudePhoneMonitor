{
  "name": "claude-phone-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "MVP monitor for Claude Code sessions with a macOS collector, relay, Skill, and Android pixel pet.",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:helpers && npm run test:github && npm run test:ci && npm run test:live",
    "typecheck": "npm run typecheck:protocol && npm run typecheck:collector && npm run typecheck:relay",
    "test:protocol": "npm --prefix packages/protocol test",
    "test:collector": "npm --prefix services/collector test",
    "test:relay": "npm --prefix services/relay test",
    "test:codex-monitor": "node --import ./services/collector/node_modules/tsx/dist/loader.mjs --test tests/codex-monitor-harness.test.mjs",
    "test:usage-monitor": "node --import ./services/collector/node_modules/tsx/dist/loader.mjs --test tests/usage-monitor-harness.test.mjs",
    "typecheck:protocol": "npm --prefix packages/protocol run typecheck",
    "typecheck:collector": "npm --prefix services/collector run typecheck",
    "typecheck:relay": "npm --prefix services/relay run typecheck",
    "relay:dev": "npm --prefix services/relay run dev",
    "collector:dev": "npm --prefix services/collector run dev",
    "mvp:harness": "node --test tests/monitor-mvp-harness.test.mjs",
    "ci:install": "node scripts/ci/install.mjs",
    "lint": "eslint .",
    "build": "node scripts/ci/build.mjs",
    "test:unit": "npm run test:protocol && npm run test:collector && npm run test:relay",
    "test:integration": "node --test tests/monitor-mvp-harness.test.mjs && npm run test:codex-monitor && npm run test:usage-monitor",
    "test:helpers": "bash skills/claude-monitor/tests/test_scripts.sh",
    "test:github": "python3 -m unittest discover -s .github/tests -p \"test_*.py\"",
    "test:live": "npm run build && node scripts/ci/relay-smoke.mjs",
    "test:ci": "npm run build && node --test tests/ci/*.test.mjs",
    "check:shell": "node scripts/ci/check-shell.mjs",
    "check:workflows": "bash scripts/ci/check-workflows.sh",
    "package:backend": "node scripts/ci/package-backend.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.48.1",
    "globals": "16.5.0"
  }
}
